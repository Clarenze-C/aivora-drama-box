{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microdrama.local/schemas/audio_ledger.schema.json",
  "title": "Audio Ledger",
  "type": "object",
  "required": ["voices", "dialogue_takes", "narration_chunks", "music_themes", "cues", "room_tones", "mixes"],
  "properties": {
    "voices": {
      "type": "object",
      "patternProperties": {
        "^VO_[A-Z0-9_]+$": {
          "type": "object",
          "required": ["owner", "timbre", "pace", "rights"],
          "properties": {
            "owner": { "type": "string" },
            "timbre": { "type": "string" },
            "pace": { "type": ["string", "number"] },
            "emotional_ceiling": { "type": "string" },
            "engine": { "type": "string" },
            "parameter_version": { "type": "string" },
            "golden_samples": { "type": "array", "items": { "type": "string" } },
            "rights": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "pronunciation_dictionary": { "type": "object" },
    "dialogue_takes": { "type": "array", "items": { "type": "object" } },
    "narration_chunks": { "type": "array", "items": { "type": "object" } },
    "alignments": { "type": "array", "items": { "type": "object" } },
    "music_themes": {
      "type": "object",
      "patternProperties": {
        "^MUS_[A-Z0-9_]+$": {
          "type": "object",
          "required": ["function", "motif", "rights"],
          "properties": {
            "function": { "type": "string" },
            "motif": { "type": "string" },
            "tempo_range": { "type": "string" },
            "palette": { "type": "array", "items": { "type": "string" } },
            "versions": { "type": "array", "items": { "type": "string" } },
            "stems": { "type": "array", "items": { "type": "string" } },
            "rights": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "cues": { "type": "array", "items": { "type": "object" } },
    "room_tones": { "type": "object" },
    "foley_cues": { "type": "array", "items": { "type": "object" } },
    "mixes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": { "type": "string" },
          "integrated_lufs": { "type": "number" },
          "true_peak_dbtp": { "type": "number" },
          "mono_check": { "type": "string" },
          "device_qc": { "type": "object" },
          "master_files": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "rights_log": { "type": "object" },
    "change_log": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
