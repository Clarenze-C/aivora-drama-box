{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microdrama.local/schemas/continuity_ledger.schema.json",
  "title": "Continuity Ledger",
  "type": "object",
  "required": ["episode_id", "shots", "events", "issues"],
  "properties": {
    "episode_id": {
      "type": "string",
      "pattern": "^E[0-9]{3}$"
    },
    "location_setup": {
      "type": "object",
      "properties": {
        "location_id": { "type": "string" },
        "coordinate_system": { "type": "string" },
        "anchors": { "type": "object" },
        "primary_axis": { "type": "string" },
        "camera_side": { "type": "string" }
      },
      "additionalProperties": true
    },
    "shots": {
      "type": "object",
      "patternProperties": {
        "^E[0-9]{3}_S[0-9]{2}$": {
          "type": "object",
          "required": ["state_in", "state_out"],
          "properties": {
            "state_in": { "type": "object" },
            "state_out": { "type": "object" },
            "world_positions": { "type": "object" },
            "screen_positions": { "type": "object" },
            "eyelines": { "type": "object" },
            "action_handoff": { "type": "object" },
            "reference_policy": {
              "type": "object",
              "properties": {
                "identity_refs": { "type": "array", "items": { "type": "string" } },
                "asset_refs": { "type": "array", "items": { "type": "string" } },
                "continuity_ref": { "type": "string" },
                "hard_reset": { "type": "boolean" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "entity", "field", "from", "to", "visible_in"],
        "properties": {
          "event_id": { "type": "string" },
          "entity": { "type": "string" },
          "field": { "type": "string" },
          "from": {},
          "to": {},
          "visible_in": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue_id", "category", "severity", "status"],
        "properties": {
          "issue_id": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "type": "string" },
          "evidence": { "type": "string" },
          "return_to": { "type": "string" },
          "status": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
