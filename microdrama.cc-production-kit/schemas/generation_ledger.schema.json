{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microdrama.local/schemas/generation_ledger.schema.json",
  "title": "Generation Ledger",
  "type": "object",
  "required": ["project_id", "routes", "attempts"],
  "properties": {
    "project_id": { "type": "string" },
    "routes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["shot_classes", "rights_status"],
        "properties": {
          "shot_classes": { "type": "array", "items": { "type": "string" } },
          "model": { "type": "string" },
          "model_version": { "type": "string" },
          "rights_status": { "type": "string" },
          "fallback_route": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["generation_id", "shot_id", "route", "inputs", "result"],
        "properties": {
          "generation_id": { "type": "string", "pattern": "^GEN_[A-Z0-9_]+$" },
          "shot_id": { "type": "string", "pattern": "^E[0-9]{3}_S[0-9]{2}$" },
          "route": { "type": "string" },
          "model_version": { "type": "string" },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "prompt_version": { "type": "string" },
          "parameters": { "type": "object" },
          "seed": {},
          "duration_generated_seconds": { "type": "number", "minimum": 0 },
          "usable_range": { "type": "string" },
          "usable_seconds": { "type": "number", "minimum": 0 },
          "compute_cost": { "type": "number", "minimum": 0 },
          "review_minutes": { "type": "number", "minimum": 0 },
          "repair_minutes": { "type": "number", "minimum": 0 },
          "result": {
            "type": "string",
            "enum": ["approved", "usable_after_repair", "partial", "rejected", "blocked"]
          },
          "defects": { "type": "array", "items": { "type": "string" } },
          "root_cause_layer": { "type": "string" },
          "next_action": { "type": "string" },
          "output_files": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "benchmarks": { "type": "object" },
    "failure_taxonomy": { "type": "object" },
    "cost_summary": { "type": "object" }
  },
  "additionalProperties": true
}
