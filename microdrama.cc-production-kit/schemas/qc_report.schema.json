{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microdrama.local/schemas/qc_report.schema.json",
  "title": "QC Report",
  "type": "object",
  "required": [
    "qc_id",
    "artifact_id",
    "artifact_type",
    "can_advance",
    "scores",
    "issues"
  ],
  "properties": {
    "qc_id": {
      "type": "string",
      "pattern": "^QC_[A-Z0-9_]+$"
    },
    "artifact_id": { "type": "string" },
    "artifact_type": {
      "type": "string",
      "enum": [
        "opportunity_brief",
        "series_bible",
        "episode_pack",
        "asset_registry",
        "storyboard",
        "continuity_ledger",
        "keyframe",
        "motion_clip",
        "edit",
        "ad_variant",
        "rights_log"
      ]
    },
    "can_advance": { "type": "boolean" },
    "scores": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9_]+$": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
          "required": [
          "severity",
          "owner_agent",
          "problem",
            "required_fix"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "owner_agent": { "type": "string" },
          "issue_id": { "type": "string" },
          "category": { "type": "string" },
          "artifact": { "type": "string" },
          "problem": { "type": "string" },
          "evidence": { "type": "string" },
          "expected": {},
          "observed": {},
          "visible_at_normal_speed": { "type": "boolean" },
          "root_cause": { "type": "string" },
          "return_to": { "type": "string" },
          "required_fix": { "type": "string" },
          "verification": { "type": "string" },
          "regression_scope": {
            "type": "array",
            "items": { "type": "string" }
          },
          "waiver": {
            "type": "object",
            "properties": {
              "accepted": { "type": "boolean" },
              "reason": { "type": "string" },
              "approved_by": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
