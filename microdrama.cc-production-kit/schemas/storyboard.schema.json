{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microdrama.local/schemas/storyboard.schema.json",
  "title": "Storyboard Shot Row",
  "type": "object",
  "required": [
    "shot_id",
    "beat_id",
    "duration_seconds",
    "shot_size",
    "angle",
    "camera_move",
    "subject",
    "action",
    "location",
    "prompt_packet",
    "audio_intent",
    "edit_intent"
  ],
  "properties": {
    "shot_id": {
      "type": "string",
      "pattern": "^E[0-9]{3}_S[0-9]{2}$"
    },
    "beat_id": {
      "type": "string",
      "pattern": "^B[0-9]{2}$"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 10
    },
    "shot_size": { "type": "string" },
    "angle": { "type": "string" },
    "camera_move": { "type": "string" },
    "subject": { "type": "string" },
    "action": { "type": "string" },
    "expression": { "type": "string" },
    "location": { "type": "string" },
    "props": {
      "type": "array",
      "items": { "type": "string" }
    },
    "spatial_zone": { "type": "string" },
    "screen_direction": { "type": "string" },
    "eyeline_target": { "type": "string" },
    "state_in": { "type": "object" },
    "state_out": { "type": "object" },
    "action_handoff": { "type": "object" },
    "continuity_refs": {
      "type": "object",
      "properties": {
        "identity": { "type": "array", "items": { "type": "string" } },
        "assets": { "type": "array", "items": { "type": "string" } },
        "previous_frame": { "type": "string" }
      },
      "additionalProperties": true
    },
    "prompt_packet": {
      "type": "object",
      "required": [
        "medium_style",
        "subject_action_expression",
        "environment_background",
        "lighting_color",
        "aspect_ratio"
      ],
      "properties": {
        "medium_style": { "type": "string" },
        "subject_action_expression": { "type": "string" },
        "environment_background": { "type": "string" },
        "lighting_color": { "type": "string" },
        "aspect_ratio": { "type": "string" },
        "negative_prompt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "audio_intent": { "type": "string" },
    "edit_intent": { "type": "string" },
    "overlay_text": { "type": "string" },
    "continuity_risk": { "type": "string" },
    "generation_status": {
      "type": "string",
      "enum": [
        "not_started",
        "keyframe_needed",
        "keyframe_approved",
        "motion_needed",
        "motion_approved",
        "blocked"
      ]
    }
  },
  "additionalProperties": true
}
