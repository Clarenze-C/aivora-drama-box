{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microdrama.local/schemas/task_run.schema.json",
  "title": "Agent Task Run",
  "type": "object",
  "required": ["task_id", "type", "dependencies", "input_hash", "budget", "status", "idempotency_key"],
  "properties": {
    "task_id": { "type": "string" },
    "type": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "input_hash": { "type": "string" },
    "context_packet": { "type": "string" },
    "prompt_version": { "type": "string" },
    "output_schema": { "type": "string" },
    "budget": { "type": "object" },
    "retry_policy": { "type": "string" },
    "attempts": { "type": "array", "items": { "type": "object" } },
    "status": {
      "type": "string",
      "enum": ["blocked", "ready", "running", "needs_review", "completed", "failed", "cancelled"]
    },
    "idempotency_key": { "type": "string" },
    "output_artifacts": { "type": "array", "items": { "type": "string" } },
    "approval": { "type": "object" },
    "recovery": { "type": "object" },
    "events": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
