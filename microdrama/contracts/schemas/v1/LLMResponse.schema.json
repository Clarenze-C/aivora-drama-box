{
  "$defs": {
    "BudgetCategory": {
      "enum": [
        "RESEARCH_SCRIPT_PROMPTS_METADATA",
        "REFERENCES_DIALOGUE",
        "GPU_GENERATION",
        "QA_CAPTIONS",
        "CPU_STORAGE_TRANSFER",
        "METERED_MANAGEMENT",
        "RECOVERY_HEADROOM"
      ],
      "title": "BudgetCategory",
      "type": "string"
    },
    "CostBasis": {
      "description": "How an amount was established. Only PROVIDER_REPORTED/BILLED are measured.",
      "enum": [
        "SYNTHETIC_FAKE",
        "ESTIMATED",
        "PROVIDER_REPORTED",
        "BILLED"
      ],
      "title": "CostBasis",
      "type": "string"
    },
    "PriceUnit": {
      "enum": [
        "REQUEST",
        "INPUT_TOKEN_1K",
        "OUTPUT_TOKEN_1K",
        "AUDIO_SECOND",
        "VIDEO_SECOND",
        "GPU_SECOND",
        "IMAGE",
        "CHARACTER_1K",
        "GIGABYTE"
      ],
      "title": "PriceUnit",
      "type": "string"
    },
    "Provenance": {
      "description": "Where data/media came from. Fakes are always FAKE_SYNTHETIC.",
      "enum": [
        "FAKE_SYNTHETIC",
        "LIVE_PROVIDER",
        "DERIVED_LOCAL",
        "ORIGINAL_FIXTURE",
        "LICENSED"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "ReceiptKind": {
      "enum": [
        "ACCRUAL",
        "SETTLEMENT",
        "CREDIT",
        "ADJUSTMENT"
      ],
      "title": "ReceiptKind",
      "type": "string"
    },
    "UsageReceipt": {
      "additionalProperties": false,
      "description": "Observed usage. Fakes emit SYNTHETIC_FAKE; only PROVIDER_REPORTED/BILLED are measured.",
      "properties": {
        "amount_micro_usd": {
          "description": "Integer micro-USD (no floats)",
          "minimum": 0,
          "title": "Amount Micro Usd",
          "type": "integer"
        },
        "category": {
          "$ref": "#/$defs/BudgetCategory"
        },
        "cost_basis": {
          "$ref": "#/$defs/CostBasis"
        },
        "currency": {
          "default": "USD",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "episode_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Id"
        },
        "interval_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval End"
        },
        "interval_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Start"
        },
        "job_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "kind": {
          "$ref": "#/$defs/ReceiptKind"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "provider": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Provider",
          "type": "string"
        },
        "provider_receipt_id": {
          "description": "Provider-side dedupe key",
          "maxLength": 500,
          "minLength": 1,
          "title": "Provider Receipt Id",
          "type": "string"
        },
        "receipt_id": {
          "format": "uuid",
          "title": "Receipt Id",
          "type": "string"
        },
        "reservation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reservation Id"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "description": "Unsupported/stale versions are rejected",
          "title": "Schema Version",
          "type": "string"
        },
        "season_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Season Id"
        },
        "unit": {
          "$ref": "#/$defs/PriceUnit"
        },
        "units": {
          "minimum": 0,
          "title": "Units",
          "type": "integer"
        }
      },
      "required": [
        "receipt_id",
        "provider",
        "provider_receipt_id",
        "kind",
        "cost_basis",
        "category",
        "amount_micro_usd",
        "units",
        "unit",
        "observed_at",
        "provenance"
      ],
      "title": "UsageReceipt",
      "type": "object"
    }
  },
  "$id": "urn:microdrama:contracts:1.3.0:LLMResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "model_config_ref": {
      "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
      "title": "Model Config Ref",
      "type": "string"
    },
    "output": {
      "additionalProperties": true,
      "title": "Output",
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "description": "Unsupported/stale versions are rejected",
      "title": "Schema Version",
      "type": "string"
    },
    "stop_reason": {
      "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
      "title": "Stop Reason",
      "type": "string"
    },
    "usage": {
      "items": {
        "$ref": "#/$defs/UsageReceipt"
      },
      "title": "Usage",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "output",
    "stop_reason",
    "model_config_ref",
    "provenance"
  ],
  "title": "LLMResponse",
  "type": "object"
}
