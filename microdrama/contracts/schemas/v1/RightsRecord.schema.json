{
  "$defs": {
    "DisclosureKind": {
      "enum": [
        "AI_GENERATED_CONTENT",
        "SYNTHETIC_VOICE",
        "SPONSORED",
        "MEMBER_OFFER"
      ],
      "title": "DisclosureKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Pointer to evidence. A hash proves integrity/identity, not truth or rights.",
      "properties": {
        "note": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "recorded_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded At"
        },
        "ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "description": "Lowercase SHA-256 hex",
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource"
        }
      },
      "required": [
        "source",
        "ref"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceSource": {
      "enum": [
        "FAKE_FIXTURE",
        "OFFICIAL_DOCUMENTATION",
        "CONTROLLED_ACCOUNT_TEST",
        "MEASURED_BENCHMARK",
        "LICENSE_DOCUMENT"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "RightsStatus": {
      "enum": [
        "ELIGIBLE",
        "INELIGIBLE",
        "UNKNOWN",
        "EXPIRED"
      ],
      "title": "RightsStatus",
      "type": "string"
    },
    "RightsSubjectKind": {
      "enum": [
        "MODEL",
        "MODEL_OUTPUT",
        "VOICE",
        "MUSIC",
        "FONT",
        "REFERENCE",
        "STOCK"
      ],
      "title": "RightsSubjectKind",
      "type": "string"
    }
  },
  "$id": "urn:microdrama:contracts:1.2.1:RightsRecord",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commercial_use": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None = unknown (blocks)",
      "title": "Commercial Use"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "output_release_allowed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None = unknown (blocks)",
      "title": "Output Release Allowed"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "required_disclosures": {
      "items": {
        "$ref": "#/$defs/DisclosureKind"
      },
      "title": "Required Disclosures",
      "type": "array"
    },
    "rights_route_id": {
      "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
      "title": "Rights Route Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "description": "Unsupported/stale versions are rejected",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RightsStatus"
    },
    "subject_kind": {
      "$ref": "#/$defs/RightsSubjectKind"
    },
    "subject_ref": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Subject Ref",
      "type": "string"
    },
    "territories": {
      "description": "Empty = unknown",
      "items": {
        "type": "string"
      },
      "title": "Territories",
      "type": "array"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "record_id",
    "rights_route_id",
    "version",
    "subject_kind",
    "subject_ref",
    "status",
    "recorded_at"
  ],
  "title": "RightsRecord",
  "type": "object"
}
