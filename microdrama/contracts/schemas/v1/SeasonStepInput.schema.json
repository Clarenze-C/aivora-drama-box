{
  "$id": "urn:microdrama:contracts:1.0.0:SeasonStepInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "description": "Unsupported/stale versions are rejected",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_version": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope Version"
    },
    "season_id": {
      "format": "uuid",
      "title": "Season Id",
      "type": "string"
    },
    "trigger": {
      "default": "scheduled",
      "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
      "title": "Trigger",
      "type": "string"
    }
  },
  "required": [
    "season_id"
  ],
  "title": "SeasonStepInput",
  "type": "object"
}
