{
  "$defs": {
    "BudgetCategory": {
      "enum": [
        "RESEARCH_SCRIPT_PROMPTS_METADATA",
        "REFERENCES_DIALOGUE",
        "GPU_GENERATION",
        "QA_CAPTIONS",
        "CPU_STORAGE_TRANSFER",
        "METERED_MANAGEMENT",
        "RECOVERY_HEADROOM"
      ],
      "title": "BudgetCategory",
      "type": "string"
    },
    "CostBasis": {
      "description": "How an amount was established. Only PROVIDER_REPORTED/BILLED are measured.",
      "enum": [
        "SYNTHETIC_FAKE",
        "ESTIMATED",
        "PROVIDER_REPORTED",
        "BILLED"
      ],
      "title": "CostBasis",
      "type": "string"
    },
    "PriceUnit": {
      "enum": [
        "REQUEST",
        "INPUT_TOKEN_1K",
        "OUTPUT_TOKEN_1K",
        "AUDIO_SECOND",
        "VIDEO_SECOND",
        "GPU_SECOND",
        "IMAGE",
        "CHARACTER_1K",
        "GIGABYTE"
      ],
      "title": "PriceUnit",
      "type": "string"
    },
    "Provenance": {
      "description": "Where data/media came from. Fakes are always FAKE_SYNTHETIC.",
      "enum": [
        "FAKE_SYNTHETIC",
        "LIVE_PROVIDER",
        "DERIVED_LOCAL",
        "ORIGINAL_FIXTURE",
        "LICENSED"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "ReceiptKind": {
      "enum": [
        "ACCRUAL",
        "SETTLEMENT",
        "CREDIT",
        "ADJUSTMENT"
      ],
      "title": "ReceiptKind",
      "type": "string"
    },
    "SourceDocument": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "description": "Lowercase SHA-256 hex",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "excerpt": {
          "description": "Untrusted data; never instructions",
          "maxLength": 4000,
          "title": "Excerpt",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = unknown date",
          "title": "Published At"
        },
        "quality": {
          "$ref": "#/$defs/SourceQuality"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "url",
        "title",
        "retrieved_at",
        "quality",
        "excerpt",
        "content_sha256",
        "provenance"
      ],
      "title": "SourceDocument",
      "type": "object"
    },
    "SourceQuality": {
      "enum": [
        "PRIMARY_OFFICIAL",
        "REPUTABLE_SECONDARY",
        "PUBLIC_COMMENTS",
        "UNVERIFIED",
        "FIXTURE"
      ],
      "title": "SourceQuality",
      "type": "string"
    },
    "UsageReceipt": {
      "additionalProperties": false,
      "description": "Observed usage. Fakes emit SYNTHETIC_FAKE; only PROVIDER_REPORTED/BILLED are measured.",
      "properties": {
        "amount_micro_usd": {
          "description": "Integer micro-USD (no floats)",
          "minimum": 0,
          "title": "Amount Micro Usd",
          "type": "integer"
        },
        "category": {
          "$ref": "#/$defs/BudgetCategory"
        },
        "cost_basis": {
          "$ref": "#/$defs/CostBasis"
        },
        "currency": {
          "default": "USD",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "episode_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Id"
        },
        "interval_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval End"
        },
        "interval_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Start"
        },
        "job_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "kind": {
          "$ref": "#/$defs/ReceiptKind"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "provider": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Provider",
          "type": "string"
        },
        "provider_receipt_id": {
          "description": "Provider-side dedupe key",
          "maxLength": 500,
          "minLength": 1,
          "title": "Provider Receipt Id",
          "type": "string"
        },
        "receipt_id": {
          "format": "uuid",
          "title": "Receipt Id",
          "type": "string"
        },
        "reservation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reservation Id"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "description": "Unsupported/stale versions are rejected",
          "title": "Schema Version",
          "type": "string"
        },
        "season_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Season Id"
        },
        "unit": {
          "$ref": "#/$defs/PriceUnit"
        },
        "units": {
          "minimum": 0,
          "title": "Units",
          "type": "integer"
        }
      },
      "required": [
        "receipt_id",
        "provider",
        "provider_receipt_id",
        "kind",
        "cost_basis",
        "category",
        "amount_micro_usd",
        "units",
        "unit",
        "observed_at",
        "provenance"
      ],
      "title": "UsageReceipt",
      "type": "object"
    }
  },
  "$id": "urn:microdrama:contracts:1.1.0:SourceSearchResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "documents": {
      "items": {
        "$ref": "#/$defs/SourceDocument"
      },
      "title": "Documents",
      "type": "array"
    },
    "failed_source_ids": {
      "description": "Unknown, not empty",
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
        "type": "string"
      },
      "title": "Failed Source Ids",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "query_id": {
      "format": "uuid",
      "title": "Query Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "description": "Unsupported/stale versions are rejected",
      "title": "Schema Version",
      "type": "string"
    },
    "usage": {
      "items": {
        "$ref": "#/$defs/UsageReceipt"
      },
      "title": "Usage",
      "type": "array"
    }
  },
  "required": [
    "query_id",
    "provenance"
  ],
  "title": "SourceSearchResult",
  "type": "object"
}
