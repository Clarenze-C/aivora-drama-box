{
  "$defs": {
    "DisclosureKind": {
      "enum": [
        "AI_GENERATED_CONTENT",
        "SYNTHETIC_VOICE",
        "SPONSORED",
        "MEMBER_OFFER"
      ],
      "title": "DisclosureKind",
      "type": "string"
    },
    "RightsGrant": {
      "additionalProperties": false,
      "properties": {
        "commercial_use": {
          "title": "Commercial Use",
          "type": "boolean"
        },
        "evidence_sha256": {
          "items": {
            "description": "Lowercase SHA-256 hex",
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Sha256",
          "type": "array"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "output_release_allowed": {
          "title": "Output Release Allowed",
          "type": "boolean"
        },
        "rights_route_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Rights Route Id",
          "type": "string"
        },
        "rights_version": {
          "minimum": 1,
          "title": "Rights Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/RightsStatus"
        },
        "subject_kind": {
          "$ref": "#/$defs/RightsSubjectKind"
        },
        "subject_ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Subject Ref",
          "type": "string"
        },
        "territories": {
          "items": {
            "pattern": "^[A-Z]{2}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Territories",
          "type": "array"
        }
      },
      "required": [
        "rights_route_id",
        "subject_kind",
        "subject_ref",
        "rights_version",
        "status",
        "territories",
        "commercial_use",
        "output_release_allowed",
        "evidence_sha256"
      ],
      "title": "RightsGrant",
      "type": "object"
    },
    "RightsStatus": {
      "enum": [
        "ELIGIBLE",
        "INELIGIBLE",
        "UNKNOWN",
        "EXPIRED"
      ],
      "title": "RightsStatus",
      "type": "string"
    },
    "RightsSubjectKind": {
      "enum": [
        "MODEL",
        "MODEL_OUTPUT",
        "VOICE",
        "MUSIC",
        "FONT",
        "REFERENCE",
        "STOCK"
      ],
      "title": "RightsSubjectKind",
      "type": "string"
    }
  },
  "$id": "urn:microdrama:contracts:2.15.0:ApprovedSlotMetadata",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "caption": {
      "default": "",
      "maxLength": 5000,
      "title": "Caption",
      "type": "string"
    },
    "catalog_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Catalog Version"
    },
    "content_sha256": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "cover_asset_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cover Asset Id"
    },
    "cover_asset_sha256": {
      "anyOf": [
        {
          "description": "Lowercase SHA-256 hex",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cover Asset Sha256"
    },
    "cover_asset_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cover Asset Version"
    },
    "cover_rights": {
      "anyOf": [
        {
          "$ref": "#/$defs/RightsGrant"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cta_text": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cta Text"
    },
    "description": {
      "default": "",
      "maxLength": 5000,
      "title": "Description",
      "type": "string"
    },
    "disclosures": {
      "items": {
        "$ref": "#/$defs/DisclosureKind"
      },
      "title": "Disclosures",
      "type": "array"
    },
    "hashtags": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Hashtags",
      "type": "array"
    },
    "links": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "title": "Links",
      "type": "array"
    },
    "locale": {
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
      "title": "Locale",
      "type": "string"
    },
    "metadata_id": {
      "format": "uuid",
      "title": "Metadata Id",
      "type": "string"
    },
    "metadata_policy_id": {
      "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
      "title": "Metadata Policy Id",
      "type": "string"
    },
    "metadata_policy_sha256": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Metadata Policy Sha256",
      "type": "string"
    },
    "metadata_policy_version": {
      "minimum": 1,
      "title": "Metadata Policy Version",
      "type": "integer"
    },
    "metadata_version": {
      "minimum": 1,
      "title": "Metadata Version",
      "type": "integer"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "release_package_hash": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Release Package Hash",
      "type": "string"
    },
    "release_package_id": {
      "format": "uuid",
      "title": "Release Package Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "description": "V2 payload; V1 consumers must not treat it as V1",
      "title": "Schema Version",
      "type": "string"
    },
    "slot_id": {
      "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
      "title": "Slot Id",
      "type": "string"
    },
    "source": {
      "enum": [
        "OWNER_APPROVED",
        "OFFLINE_MOCK",
        "EXAMPLE"
      ],
      "title": "Source",
      "type": "string"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "record_id",
    "version",
    "content_sha256",
    "created_at",
    "updated_at",
    "valid_from",
    "release_package_id",
    "release_package_hash",
    "slot_id",
    "metadata_id",
    "metadata_version",
    "locale",
    "title",
    "metadata_policy_id",
    "metadata_policy_version",
    "metadata_policy_sha256",
    "source"
  ],
  "title": "ApprovedSlotMetadata",
  "type": "object"
}
