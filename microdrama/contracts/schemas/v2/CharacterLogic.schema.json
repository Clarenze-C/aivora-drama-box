{
  "$id": "urn:microdrama:contracts:2.15.0:CharacterLogic",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "character_id": {
      "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
      "title": "Character Id",
      "type": "string"
    },
    "content_sha256": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "flaw": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Flaw",
      "type": "string"
    },
    "knowledge_by_episode": {
      "patternProperties": {
        "^[a-z0-9][a-z0-9_.\\-]{0,119}$": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Knowledge By Episode",
      "type": "object"
    },
    "observable_goal": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Observable Goal",
      "type": "string"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "relationship_pressures": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "title": "Relationship Pressures",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "description": "V2 payload; V1 consumers must not treat it as V1",
      "title": "Schema Version",
      "type": "string"
    },
    "season_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Season Id"
    },
    "secret_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Secret Id"
    },
    "strategy": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Strategy",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "record_id",
    "version",
    "content_sha256",
    "created_at",
    "updated_at",
    "valid_from",
    "character_id",
    "observable_goal",
    "strategy",
    "flaw"
  ],
  "title": "CharacterLogic",
  "type": "object"
}
