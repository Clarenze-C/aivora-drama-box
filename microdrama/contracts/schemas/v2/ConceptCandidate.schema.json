{
  "$defs": {
    "PendingRightsAssessment": {
      "additionalProperties": false,
      "description": "Candidate-stage rights status when eligibility has not been established.",
      "properties": {
        "note": {
          "description": "Known limitation or unresolved question; this is not production rights evidence",
          "maxLength": 500,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "status": {
          "enum": [
            "PENDING",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "note"
      ],
      "title": "PendingRightsAssessment",
      "type": "object"
    },
    "RightsGrant": {
      "additionalProperties": false,
      "properties": {
        "commercial_use": {
          "title": "Commercial Use",
          "type": "boolean"
        },
        "evidence_sha256": {
          "items": {
            "description": "Lowercase SHA-256 hex",
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Sha256",
          "type": "array"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "output_release_allowed": {
          "title": "Output Release Allowed",
          "type": "boolean"
        },
        "rights_route_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Rights Route Id",
          "type": "string"
        },
        "rights_version": {
          "minimum": 1,
          "title": "Rights Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/RightsStatus"
        },
        "subject_kind": {
          "$ref": "#/$defs/RightsSubjectKind"
        },
        "subject_ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Subject Ref",
          "type": "string"
        },
        "territories": {
          "items": {
            "pattern": "^[A-Z]{2}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Territories",
          "type": "array"
        }
      },
      "required": [
        "rights_route_id",
        "subject_kind",
        "subject_ref",
        "rights_version",
        "status",
        "territories",
        "commercial_use",
        "output_release_allowed",
        "evidence_sha256"
      ],
      "title": "RightsGrant",
      "type": "object"
    },
    "RightsStatus": {
      "enum": [
        "ELIGIBLE",
        "INELIGIBLE",
        "UNKNOWN",
        "EXPIRED"
      ],
      "title": "RightsStatus",
      "type": "string"
    },
    "RightsSubjectKind": {
      "enum": [
        "MODEL",
        "MODEL_OUTPUT",
        "VOICE",
        "MUSIC",
        "FONT",
        "REFERENCE",
        "STOCK"
      ],
      "title": "RightsSubjectKind",
      "type": "string"
    }
  },
  "$id": "urn:microdrama:contracts:2.15.0:ConceptCandidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_sha256": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "episode_count": {
      "maximum": 10,
      "minimum": 1,
      "title": "Episode Count",
      "type": "integer"
    },
    "escalation": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Escalation",
      "type": "array"
    },
    "intake_id": {
      "format": "uuid",
      "title": "Intake Id",
      "type": "string"
    },
    "logline": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Logline",
      "type": "string"
    },
    "payoff_debt": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Payoff Debt",
      "type": "array"
    },
    "promise": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Promise",
      "type": "string"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "rights": {
      "anyOf": [
        {
          "$ref": "#/$defs/RightsGrant"
        },
        {
          "$ref": "#/$defs/PendingRightsAssessment"
        }
      ],
      "description": "Candidate assessment may be pending/unknown; production bindings require RightsGrant",
      "title": "Rights"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "description": "V2 payload; V1 consumers must not treat it as V1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_sha256": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scope Sha256",
      "type": "string"
    },
    "title_en": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title En",
      "type": "string"
    },
    "title_th": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title Th",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "record_id",
    "version",
    "content_sha256",
    "created_at",
    "updated_at",
    "valid_from",
    "intake_id",
    "title_th",
    "title_en",
    "logline",
    "promise",
    "payoff_debt",
    "escalation",
    "episode_count",
    "scope_sha256",
    "rights"
  ],
  "title": "ConceptCandidate",
  "type": "object"
}
