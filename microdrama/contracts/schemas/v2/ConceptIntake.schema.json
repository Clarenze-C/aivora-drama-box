{
  "$id": "urn:microdrama:contracts:2.15.0:ConceptIntake",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_sha256": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "genre_tags": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Genre Tags",
      "type": "array"
    },
    "language": {
      "const": "th",
      "default": "th",
      "title": "Language",
      "type": "string"
    },
    "original_fiction": {
      "const": true,
      "default": true,
      "title": "Original Fiction",
      "type": "boolean"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "requested_episode_count": {
      "default": 10,
      "maximum": 10,
      "minimum": 1,
      "title": "Requested Episode Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "description": "V2 payload; V1 consumers must not treat it as V1",
      "title": "Schema Version",
      "type": "string"
    },
    "story_idea": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Story Idea",
      "type": "string"
    },
    "tone": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Tone",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "record_id",
    "version",
    "content_sha256",
    "created_at",
    "updated_at",
    "valid_from",
    "story_idea",
    "genre_tags",
    "tone"
  ],
  "title": "ConceptIntake",
  "type": "object"
}
