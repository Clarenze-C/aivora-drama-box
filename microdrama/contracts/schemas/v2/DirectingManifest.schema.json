{
  "$defs": {
    "DirectingSection": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "exclusiveMinimum": 0,
          "maximum": 45000,
          "title": "Duration Ms",
          "type": "integer"
        },
        "section_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Section Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "shot_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Shot Ids",
          "type": "array"
        }
      },
      "required": [
        "section_id",
        "sequence",
        "shot_ids",
        "duration_ms"
      ],
      "title": "DirectingSection",
      "type": "object"
    },
    "DirectingShot": {
      "additionalProperties": false,
      "properties": {
        "action_handoff": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Action Handoff",
          "type": "string"
        },
        "beat_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Beat Id",
          "type": "string"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "maximum": 15000,
          "title": "Duration Ms",
          "type": "integer"
        },
        "edit_intent": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Edit Intent",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/StateEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "eyeline": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Eyeline",
          "type": "string"
        },
        "framing": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Framing",
          "type": "string"
        },
        "scene_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Scene Id",
          "type": "string"
        },
        "screen_axis": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Screen Axis",
          "type": "string"
        },
        "screen_direction": {
          "enum": [
            "STATIC",
            "LEFT_TO_RIGHT",
            "RIGHT_TO_LEFT"
          ],
          "title": "Screen Direction",
          "type": "string"
        },
        "section_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Section Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "shot_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Shot Id",
          "type": "string"
        },
        "sound_intent": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Sound Intent",
          "type": "string"
        },
        "source_dependency_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Dependency Ids",
          "type": "array"
        },
        "source_hashes": {
          "items": {
            "description": "Lowercase SHA-256 hex",
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Hashes",
          "type": "array"
        },
        "state_in": {
          "items": {
            "$ref": "#/$defs/StateValue"
          },
          "title": "State In",
          "type": "array"
        },
        "state_out": {
          "items": {
            "$ref": "#/$defs/StateValue"
          },
          "title": "State Out",
          "type": "array"
        }
      },
      "required": [
        "shot_id",
        "scene_id",
        "beat_id",
        "sequence",
        "duration_ms",
        "section_id",
        "screen_axis",
        "screen_direction",
        "eyeline",
        "action_handoff",
        "sound_intent",
        "edit_intent",
        "framing",
        "source_dependency_ids",
        "source_hashes"
      ],
      "title": "DirectingShot",
      "type": "object"
    },
    "StateEvent": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "After"
        },
        "before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before"
        },
        "content_sha256": {
          "description": "Lowercase SHA-256 hex",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "effective_from_ms": {
          "minimum": 0,
          "title": "Effective From Ms",
          "type": "integer"
        },
        "effective_until_ms": {
          "exclusiveMinimum": 0,
          "title": "Effective Until Ms",
          "type": "integer"
        },
        "entity_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Entity Id",
          "type": "string"
        },
        "episode_id": {
          "format": "uuid",
          "title": "Episode Id",
          "type": "string"
        },
        "evidence_sha256": {
          "description": "Lowercase SHA-256 hex",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "field": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Field",
          "type": "string"
        },
        "record_id": {
          "format": "uuid",
          "title": "Record Id",
          "type": "string"
        },
        "scene_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "description": "V2 payload; V1 consumers must not treat it as V1",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "record_id",
        "version",
        "content_sha256",
        "created_at",
        "updated_at",
        "valid_from",
        "episode_id",
        "sequence",
        "entity_id",
        "field",
        "before",
        "after",
        "scene_id",
        "effective_from_ms",
        "effective_until_ms",
        "evidence_sha256"
      ],
      "title": "StateEvent",
      "type": "object"
    },
    "StateValue": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Entity Id",
          "type": "string"
        },
        "field": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Field",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "entity_id",
        "field",
        "value"
      ],
      "title": "StateValue",
      "type": "object"
    }
  },
  "$id": "urn:microdrama:contracts:2.15.0:DirectingManifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approved_scope_hash": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approved Scope Hash",
      "type": "string"
    },
    "content_sha256": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "episode_id": {
      "format": "uuid",
      "title": "Episode Id",
      "type": "string"
    },
    "pack_hash": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pack Hash",
      "type": "string"
    },
    "pack_id": {
      "format": "uuid",
      "title": "Pack Id",
      "type": "string"
    },
    "pack_version": {
      "minimum": 1,
      "title": "Pack Version",
      "type": "integer"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "description": "V2 payload; V1 consumers must not treat it as V1",
      "title": "Schema Version",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/DirectingSection"
      },
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/DirectingShot"
      },
      "minItems": 1,
      "title": "Shots",
      "type": "array"
    },
    "source_hashes": {
      "items": {
        "description": "Lowercase SHA-256 hex",
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Hashes",
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "record_id",
    "version",
    "content_sha256",
    "created_at",
    "updated_at",
    "valid_from",
    "episode_id",
    "pack_id",
    "pack_version",
    "pack_hash",
    "approved_scope_hash",
    "shots",
    "sections",
    "source_hashes"
  ],
  "title": "DirectingManifest",
  "type": "object"
}
