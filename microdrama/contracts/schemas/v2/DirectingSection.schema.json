{
  "$id": "urn:microdrama:contracts:2.15.0:DirectingSection",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "duration_ms": {
      "exclusiveMinimum": 0,
      "maximum": 45000,
      "title": "Duration Ms",
      "type": "integer"
    },
    "section_id": {
      "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
      "title": "Section Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "shot_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Shot Ids",
      "type": "array"
    }
  },
  "required": [
    "section_id",
    "sequence",
    "shot_ids",
    "duration_ms"
  ],
  "title": "DirectingSection",
  "type": "object"
}
