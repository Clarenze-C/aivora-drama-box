{
  "$defs": {
    "CharacterLogic": {
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Character Id",
          "type": "string"
        },
        "content_sha256": {
          "description": "Lowercase SHA-256 hex",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "flaw": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Flaw",
          "type": "string"
        },
        "knowledge_by_episode": {
          "patternProperties": {
            "^[a-z0-9][a-z0-9_.\\-]{0,119}$": {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Knowledge By Episode",
          "type": "object"
        },
        "observable_goal": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Observable Goal",
          "type": "string"
        },
        "record_id": {
          "format": "uuid",
          "title": "Record Id",
          "type": "string"
        },
        "relationship_pressures": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Relationship Pressures",
          "type": "array"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "description": "V2 payload; V1 consumers must not treat it as V1",
          "title": "Schema Version",
          "type": "string"
        },
        "season_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Season Id"
        },
        "secret_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secret Id"
        },
        "strategy": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Strategy",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "record_id",
        "version",
        "content_sha256",
        "created_at",
        "updated_at",
        "valid_from",
        "character_id",
        "observable_goal",
        "strategy",
        "flaw"
      ],
      "title": "CharacterLogic",
      "type": "object"
    },
    "EpisodeScene": {
      "additionalProperties": false,
      "properties": {
        "beats": {
          "items": {
            "$ref": "#/$defs/PackBeat"
          },
          "minItems": 1,
          "title": "Beats",
          "type": "array"
        },
        "dependency_scene_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
            "type": "string"
          },
          "title": "Dependency Scene Ids",
          "type": "array"
        },
        "location_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Location Id",
          "type": "string"
        },
        "prop_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
            "type": "string"
          },
          "title": "Prop Ids",
          "type": "array"
        },
        "scene_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Scene Id",
          "type": "string"
        },
        "scene_number": {
          "minimum": 1,
          "title": "Scene Number",
          "type": "integer"
        },
        "state_in": {
          "items": {
            "$ref": "#/$defs/StateValue"
          },
          "title": "State In",
          "type": "array"
        },
        "state_out": {
          "items": {
            "$ref": "#/$defs/StateValue"
          },
          "title": "State Out",
          "type": "array"
        },
        "story_time": {
          "$ref": "#/$defs/StoryTime"
        },
        "visible_character_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Visible Character Ids",
          "type": "array"
        },
        "wardrobe_assignment_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Wardrobe Assignment Ids",
          "type": "array"
        }
      },
      "required": [
        "scene_id",
        "scene_number",
        "story_time",
        "location_id",
        "visible_character_ids",
        "beats"
      ],
      "title": "EpisodeScene",
      "type": "object"
    },
    "PackBeat": {
      "additionalProperties": false,
      "properties": {
        "beat_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Beat Id",
          "type": "string"
        },
        "dependency_beat_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
            "type": "string"
          },
          "title": "Dependency Beat Ids",
          "type": "array"
        },
        "function": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Function",
          "type": "string"
        },
        "proof_object_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
            "type": "string"
          },
          "title": "Proof Object Ids",
          "type": "array"
        },
        "required_asset_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Required Asset Ids",
          "type": "array"
        },
        "reveal_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
            "type": "string"
          },
          "title": "Reveal Ids",
          "type": "array"
        },
        "state_in": {
          "items": {
            "$ref": "#/$defs/StateValue"
          },
          "title": "State In",
          "type": "array"
        },
        "state_out": {
          "items": {
            "$ref": "#/$defs/StateValue"
          },
          "title": "State Out",
          "type": "array"
        },
        "visible_action": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Visible Action",
          "type": "string"
        }
      },
      "required": [
        "beat_id",
        "function",
        "visible_action"
      ],
      "title": "PackBeat",
      "type": "object"
    },
    "StateValue": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Entity Id",
          "type": "string"
        },
        "field": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Field",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "entity_id",
        "field",
        "value"
      ],
      "title": "StateValue",
      "type": "object"
    },
    "StoryTime": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "description": "Lowercase SHA-256 hex",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "local_time": {
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Local Time",
          "type": "string"
        },
        "record_id": {
          "format": "uuid",
          "title": "Record Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "description": "V2 payload; V1 consumers must not treat it as V1",
          "title": "Schema Version",
          "type": "string"
        },
        "setting": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Setting",
          "type": "string"
        },
        "story_day": {
          "minimum": 1,
          "title": "Story Day",
          "type": "integer"
        },
        "timezone": {
          "default": "Asia/Bangkok",
          "title": "Timezone",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "record_id",
        "version",
        "content_sha256",
        "created_at",
        "updated_at",
        "valid_from",
        "story_day",
        "local_time",
        "setting"
      ],
      "title": "StoryTime",
      "type": "object"
    }
  },
  "$id": "urn:microdrama:contracts:2.15.0:EpisodePack",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approved_scope_hash": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approved Scope Hash",
      "type": "string"
    },
    "character_logic": {
      "items": {
        "$ref": "#/$defs/CharacterLogic"
      },
      "minItems": 1,
      "title": "Character Logic",
      "type": "array"
    },
    "content_sha256": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "duration_target_ms": {
      "maximum": 300000,
      "minimum": 180000,
      "title": "Duration Target Ms",
      "type": "integer"
    },
    "episode_id": {
      "format": "uuid",
      "title": "Episode Id",
      "type": "string"
    },
    "episode_number": {
      "minimum": 1,
      "title": "Episode Number",
      "type": "integer"
    },
    "escalation": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Escalation",
      "type": "string"
    },
    "payoff_debt": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Payoff Debt",
      "type": "array"
    },
    "promise": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Promise",
      "type": "string"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/EpisodeScene"
      },
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "description": "V2 payload; V1 consumers must not treat it as V1",
      "title": "Schema Version",
      "type": "string"
    },
    "scoped_map_only": {
      "default": false,
      "title": "Scoped Map Only",
      "type": "boolean"
    },
    "season_id": {
      "format": "uuid",
      "title": "Season Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "record_id",
    "version",
    "content_sha256",
    "created_at",
    "updated_at",
    "valid_from",
    "episode_id",
    "season_id",
    "approved_scope_hash",
    "episode_number",
    "duration_target_ms",
    "character_logic",
    "promise",
    "escalation",
    "scenes"
  ],
  "title": "EpisodePack",
  "type": "object"
}
