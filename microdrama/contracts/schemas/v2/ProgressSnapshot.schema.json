{
  "$defs": {
    "ProgressStage": {
      "enum": [
        "PLANNED",
        "RUNNING",
        "WAITING",
        "BLOCKED",
        "COMPLETE"
      ],
      "title": "ProgressStage",
      "type": "string"
    }
  },
  "$id": "urn:microdrama:contracts:2.15.0:ProgressSnapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_work": {
      "minimum": 0,
      "title": "Accepted Work",
      "type": "integer"
    },
    "aggregate_id": {
      "format": "uuid",
      "title": "Aggregate Id",
      "type": "string"
    },
    "blocker_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
        "type": "string"
      },
      "title": "Blocker Ids",
      "type": "array"
    },
    "content_sha256": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "next_action": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Action"
    },
    "production_stage": {
      "$ref": "#/$defs/ProgressStage"
    },
    "progress_bp": {
      "anyOf": [
        {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Progress Bp"
    },
    "projection_revision": {
      "minimum": 1,
      "title": "Projection Revision",
      "type": "integer"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "release_stage": {
      "$ref": "#/$defs/ProgressStage"
    },
    "required_work": {
      "minimum": 0,
      "title": "Required Work",
      "type": "integer"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "description": "V2 payload; V1 consumers must not treat it as V1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Source Asset Ids",
      "type": "array"
    },
    "source_event_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Event Ids",
      "type": "array"
    },
    "source_job_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Source Job Ids",
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "record_id",
    "version",
    "content_sha256",
    "created_at",
    "updated_at",
    "valid_from",
    "aggregate_id",
    "projection_revision",
    "source_event_ids",
    "production_stage",
    "release_stage",
    "accepted_work",
    "required_work"
  ],
  "title": "ProgressSnapshot",
  "type": "object"
}
