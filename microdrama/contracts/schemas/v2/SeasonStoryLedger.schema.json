{
  "$defs": {
    "PayoffDebt": {
      "additionalProperties": false,
      "properties": {
        "debt_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Debt Id",
          "type": "string"
        },
        "description": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "due_episode": {
          "minimum": 1,
          "title": "Due Episode",
          "type": "integer"
        },
        "status": {
          "default": "OPEN",
          "enum": [
            "OPEN",
            "PAID_OFF"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "debt_id",
        "description",
        "due_episode"
      ],
      "title": "PayoffDebt",
      "type": "object"
    },
    "SeasonEscalation": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "episode_number": {
          "minimum": 1,
          "title": "Episode Number",
          "type": "integer"
        }
      },
      "required": [
        "episode_number",
        "description"
      ],
      "title": "SeasonEscalation",
      "type": "object"
    }
  },
  "$id": "urn:microdrama:contracts:2.15.0:SeasonStoryLedger",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approved_scope_hash": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approved Scope Hash",
      "type": "string"
    },
    "character_logic_record_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Character Logic Record Ids",
      "type": "array"
    },
    "content_sha256": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "escalations": {
      "items": {
        "$ref": "#/$defs/SeasonEscalation"
      },
      "minItems": 1,
      "title": "Escalations",
      "type": "array"
    },
    "payoff_debts": {
      "items": {
        "$ref": "#/$defs/PayoffDebt"
      },
      "minItems": 1,
      "title": "Payoff Debts",
      "type": "array"
    },
    "promise": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Promise",
      "type": "string"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "description": "V2 payload; V1 consumers must not treat it as V1",
      "title": "Schema Version",
      "type": "string"
    },
    "season_id": {
      "format": "uuid",
      "title": "Season Id",
      "type": "string"
    },
    "secret_ledger_id": {
      "format": "uuid",
      "title": "Secret Ledger Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "record_id",
    "version",
    "content_sha256",
    "created_at",
    "updated_at",
    "valid_from",
    "season_id",
    "approved_scope_hash",
    "promise",
    "payoff_debts",
    "escalations",
    "character_logic_record_ids",
    "secret_ledger_id"
  ],
  "title": "SeasonStoryLedger",
  "type": "object"
}
