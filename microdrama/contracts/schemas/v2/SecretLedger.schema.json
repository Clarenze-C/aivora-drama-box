{
  "$defs": {
    "SecretEntry": {
      "additionalProperties": false,
      "properties": {
        "fact": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Fact",
          "type": "string"
        },
        "held_by_character_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Held By Character Id",
          "type": "string"
        },
        "known_by_character_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
            "type": "string"
          },
          "title": "Known By Character Ids",
          "type": "array"
        },
        "planned_reveal_episode": {
          "minimum": 1,
          "title": "Planned Reveal Episode",
          "type": "integer"
        },
        "secret_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Secret Id",
          "type": "string"
        }
      },
      "required": [
        "secret_id",
        "held_by_character_id",
        "fact",
        "planned_reveal_episode"
      ],
      "title": "SecretEntry",
      "type": "object"
    }
  },
  "$id": "urn:microdrama:contracts:2.15.0:SecretLedger",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_sha256": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "description": "V2 payload; V1 consumers must not treat it as V1",
      "title": "Schema Version",
      "type": "string"
    },
    "season_id": {
      "format": "uuid",
      "title": "Season Id",
      "type": "string"
    },
    "secrets": {
      "items": {
        "$ref": "#/$defs/SecretEntry"
      },
      "minItems": 1,
      "title": "Secrets",
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "record_id",
    "version",
    "content_sha256",
    "created_at",
    "updated_at",
    "valid_from",
    "season_id",
    "secrets"
  ],
  "title": "SecretLedger",
  "type": "object"
}
