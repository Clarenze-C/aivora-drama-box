{
  "$id": "urn:microdrama:contracts:2.15.0:StateValue",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entity_id": {
      "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
      "title": "Entity Id",
      "type": "string"
    },
    "field": {
      "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
      "title": "Field",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "entity_id",
    "field",
    "value"
  ],
  "title": "StateValue",
  "type": "object"
}
