{
  "$id": "urn:microdrama:contracts:2.15.0:StoryTime",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_sha256": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "local_time": {
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
      "title": "Local Time",
      "type": "string"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "description": "V2 payload; V1 consumers must not treat it as V1",
      "title": "Schema Version",
      "type": "string"
    },
    "setting": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Setting",
      "type": "string"
    },
    "story_day": {
      "minimum": 1,
      "title": "Story Day",
      "type": "integer"
    },
    "timezone": {
      "default": "Asia/Bangkok",
      "title": "Timezone",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "record_id",
    "version",
    "content_sha256",
    "created_at",
    "updated_at",
    "valid_from",
    "story_day",
    "local_time",
    "setting"
  ],
  "title": "StoryTime",
  "type": "object"
}
