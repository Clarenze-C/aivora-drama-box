{
  "$defs": {
    "RightsGrant": {
      "additionalProperties": false,
      "properties": {
        "commercial_use": {
          "title": "Commercial Use",
          "type": "boolean"
        },
        "evidence_sha256": {
          "items": {
            "description": "Lowercase SHA-256 hex",
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Sha256",
          "type": "array"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "output_release_allowed": {
          "title": "Output Release Allowed",
          "type": "boolean"
        },
        "rights_route_id": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,119}$",
          "title": "Rights Route Id",
          "type": "string"
        },
        "rights_version": {
          "minimum": 1,
          "title": "Rights Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/RightsStatus"
        },
        "subject_kind": {
          "$ref": "#/$defs/RightsSubjectKind"
        },
        "subject_ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Subject Ref",
          "type": "string"
        },
        "territories": {
          "items": {
            "pattern": "^[A-Z]{2}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Territories",
          "type": "array"
        }
      },
      "required": [
        "rights_route_id",
        "subject_kind",
        "subject_ref",
        "rights_version",
        "status",
        "territories",
        "commercial_use",
        "output_release_allowed",
        "evidence_sha256"
      ],
      "title": "RightsGrant",
      "type": "object"
    },
    "RightsStatus": {
      "enum": [
        "ELIGIBLE",
        "INELIGIBLE",
        "UNKNOWN",
        "EXPIRED"
      ],
      "title": "RightsStatus",
      "type": "string"
    },
    "RightsSubjectKind": {
      "enum": [
        "MODEL",
        "MODEL_OUTPUT",
        "VOICE",
        "MUSIC",
        "FONT",
        "REFERENCE",
        "STOCK"
      ],
      "title": "RightsSubjectKind",
      "type": "string"
    }
  },
  "$id": "urn:microdrama:contracts:2.15.0:StyleBible",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_sha256": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "exclusions": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Exclusions",
      "type": "array"
    },
    "lens_and_movement": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Lens And Movement",
      "type": "string"
    },
    "lighting_language": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Lighting Language",
      "type": "string"
    },
    "material_rules": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Material Rules",
      "type": "array"
    },
    "medium": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Medium",
      "type": "string"
    },
    "moving_sample_asset_id": {
      "format": "uuid",
      "title": "Moving Sample Asset Id",
      "type": "string"
    },
    "moving_sample_sha256": {
      "description": "Lowercase SHA-256 hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Moving Sample Sha256",
      "type": "string"
    },
    "palette": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 2,
      "title": "Palette",
      "type": "array"
    },
    "realism": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Realism",
      "type": "string"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "rights": {
      "$ref": "#/$defs/RightsGrant"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "description": "V2 payload; V1 consumers must not treat it as V1",
      "title": "Schema Version",
      "type": "string"
    },
    "season_id": {
      "format": "uuid",
      "title": "Season Id",
      "type": "string"
    },
    "sound_motifs": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Sound Motifs",
      "type": "array"
    },
    "subtitle_safe_bottom_bp": {
      "maximum": 4000,
      "minimum": 0,
      "title": "Subtitle Safe Bottom Bp",
      "type": "integer"
    },
    "subtitle_safe_top_bp": {
      "maximum": 4000,
      "minimum": 0,
      "title": "Subtitle Safe Top Bp",
      "type": "integer"
    },
    "typography_rules": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Typography Rules",
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "record_id",
    "version",
    "content_sha256",
    "created_at",
    "updated_at",
    "valid_from",
    "season_id",
    "medium",
    "realism",
    "palette",
    "lighting_language",
    "lens_and_movement",
    "material_rules",
    "typography_rules",
    "subtitle_safe_top_bp",
    "subtitle_safe_bottom_bp",
    "sound_motifs",
    "exclusions",
    "moving_sample_asset_id",
    "moving_sample_sha256",
    "rights"
  ],
  "title": "StyleBible",
  "type": "object"
}
